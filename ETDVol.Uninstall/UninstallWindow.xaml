<Window x:Class="ETDVol.Uninstall.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETDVol Kaldırma Sihirbazı" Icon="app.png" Height="300" Width="440"
        Background="#202020" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header with Exact App Logo & Language Selection -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="app.png" Width="36" Height="36" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTitle" Text="ETDVol Kaldırma" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnLangTR" Content="TR" Width="32" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangTR_Click" Cursor="Hand" Margin="0,0,5,0"/>
                <Button x:Name="BtnLangEN" Content="EN" Width="32" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangEN_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="TxtPrompt" Text="ETDVol uygulamasını bilgisayarınızdan kaldırmak istediğinize emin misiniz?" 
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#CCCCCC" FontSize="14" Margin="0,15,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnUninstall" Grid.Column="0" Content="Kaldır" Height="40" Background="#FF6600" Foreground="White" 
                        FontWeight="SemiBold" FontSize="14" BorderThickness="0" Click="BtnUninstall_Click" Cursor="Hand"/>
                <Button x:Name="BtnCancel" Grid.Column="2" Content="İptal" Height="40" Background="#3A3A3A" Foreground="White" 
                        FontWeight="SemiBold" FontSize="14" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
            </Grid>
            <TextBlock x:Name="TxtStatus" Text="" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#00FF00" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
