<Window x:Class="ETDVol.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETDVol Kurulum Sihirbazı" Icon="app.png" Height="450" Width="520"
        Background="#202020" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header with Exact App Logo & Language Selection -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="app.png" Width="36" Height="36" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTitle" Text="ETDVol Kurulum Sihirbazı" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnLangTR" Content="TR" Width="32" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangTR_Click" Cursor="Hand" Margin="0,0,5,0"/>
                <Button x:Name="BtnLangEN" Content="EN" Width="32" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangEN_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Main Form Area -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,15">
            <TextBlock x:Name="TxtDescription" Text="ETDVol uygulamasını bilgisayarınıza kurmak için aşağıdaki seçenekleri belirleyin." 
                       TextWrapping="Wrap" Foreground="#CCCCCC" Margin="0,0,0,20" FontSize="14"/>

            <!-- Folder Selection -->
            <TextBlock x:Name="TxtFolderLabel" Text="Hedef Kurulum Klasörü:" FontSize="13" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInstallPath" Grid.Column="0" Height="35" Background="#2B2B2B" Foreground="White" 
                         BorderBrush="#555555" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Gözat..." Width="80" Height="35" Margin="8,0,0,0" 
                        Background="#3A3A3A" Foreground="White" BorderThickness="0" Click="BtnBrowse_Click" Cursor="Hand"/>
            </Grid>

            <!-- Options -->
            <CheckBox x:Name="ChkAutoStart" Content="Windows başladığında otomatik çalıştır" IsChecked="True" 
                      Foreground="White" FontSize="14" Margin="0,0,0,15"/>
        </StackPanel>

        <!-- Bottom Action Area -->
        <StackPanel Grid.Row="2">
            <Button x:Name="BtnInstall" Content="Kurulumu Başlat" Height="42" Background="#FF6600" Foreground="White" 
                    FontWeight="SemiBold" FontSize="15" BorderThickness="0" Click="BtnInstall_Click" Cursor="Hand"/>
                    
            <TextBlock x:Name="TxtStatus" Text="" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#00FF00" FontSize="13"/>
        </StackPanel>
    </Grid>
</Window>
