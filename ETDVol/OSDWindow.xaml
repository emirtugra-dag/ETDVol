<Window x:Class="ETDVol.OSDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETDVol OSD"
        SizeToContent="WidthAndHeight"
        MinWidth="280" MaxWidth="650"
        MinHeight="90" MaxHeight="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Loaded="Window_Loaded" Closing="Window_Closing">
    
    <Border Background="#D81E1E1E" CornerRadius="12" BorderBrush="#44FFFFFF" BorderThickness="1" 
            Margin="10" Padding="15,10" Cursor="Hand" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock x:Name="DeviceNameText" Text="Speaker" Foreground="White" FontSize="14" FontWeight="SemiBold" 
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <ProgressBar x:Name="VolumeProgress" Minimum="0" Maximum="100" Value="50" Height="8" 
                             Foreground="#FFFF3300" Background="#33FFFFFF" BorderThickness="0"/>
                <TextBlock x:Name="VolumeText" Text="50%" Foreground="White" FontSize="12" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-18,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
