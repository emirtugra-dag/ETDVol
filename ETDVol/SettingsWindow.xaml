<Window x:Class="ETDVol.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETDVol Ayarları"
        Height="500" Width="460"
        Background="#202020" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="SpaceBetween">
            <TextBlock Text="ETDVol Ayarları" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLangTR" Content="TR" Width="30" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangTR_Click" Cursor="Hand" Margin="0,0,5,0"/>
                <Button x:Name="BtnLangEN" Content="EN" Width="30" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangEN_Click" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="ChkAutoStart" Content="Windows ile Birlikte Başlat" Foreground="White" Margin="0,5,0,5" IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                <CheckBox x:Name="ChkHotkeys" Content="Kısayol Tuşlarını Etkinleştir (Ctrl+Up/Down, Ctrl+M vb.)" Foreground="White" Margin="0,5,0,5" IsChecked="{Binding EnableHotkeys, Mode=TwoWay}" />
                <CheckBox x:Name="ChkAcceleration" Content="Dinamik Scroll İvmelenmesini Kullan" Foreground="White" Margin="0,5,0,5" IsChecked="{Binding EnableAcceleration, Mode=TwoWay}" />
                <CheckBox x:Name="ChkOSD" Content="Ekrandaki Görsel Göstergeyi (OSD) Göster" Foreground="White" Margin="0,5,0,5" IsChecked="{Binding EnableOSD, Mode=TwoWay}" />
                <CheckBox x:Name="ChkTrayIcon" Content="Sistem Tepsisi Simgesini Göster" Foreground="White" Margin="0,5,0,5" IsChecked="{Binding EnableTrayIcon, Mode=TwoWay}" />

                <TextBlock Text="Ses Değişim Adımı (Yüzdelik):" Foreground="#AAAAAA" FontSize="13" Margin="0,15,0,5"/>
                <Slider x:Name="SldStepSize" Minimum="1" Maximum="10" Value="{Binding StepSize, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>

                <TextBlock Text="OSD Gösterim Süresi (ms):" Foreground="#AAAAAA" FontSize="13" Margin="0,15,0,5"/>
                <Slider x:Name="SldOsdDuration" Minimum="500" Maximum="3000" Value="{Binding OSDDurationMs, Mode=TwoWay}" TickFrequency="100" IsSnapToTickEnabled="True" AutoToolTipPlacement="TopLeft"/>

                <TextBlock Text="Cihaz Geçiş Döngüsüne Dahil Edilecekler (Shift + Orta Tuş):" Foreground="#AAAAAA" FontSize="13" Margin="0,15,0,5" TextWrapping="Wrap"/>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" Foreground="White" Margin="0,3,0,3" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Tag="{Binding Id}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="BtnApply" Grid.Row="2" Content="Uygula ve Kapat" Height="35" Margin="0,15,0,0" Background="#0078D7" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnApply_Click" Cursor="Hand"/>
    </Grid>
</Window>
