<Window x:Class="ETDVol.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ETDVol Ayarları" Icon="app.png" Height="500" Width="450"
        Background="#202020" Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="app.png" Width="36" Height="36" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtHeader" Text="ETDVol Ayarları" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnLangTR" Content="TR" Width="30" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangTR_Click" Cursor="Hand" Margin="0,0,5,0"/>
                <Button x:Name="BtnLangEN" Content="EN" Width="30" Height="30" Background="#333333" Foreground="White" BorderThickness="0" Click="BtnLangEN_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="ChkAutoStart" Content="Windows ile Birlikte Başlat" Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="ChkAcceleration" Content="Dinamik Scroll İvmelenmesini Kullan" Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="ChkOSD" Content="Ekrandaki Görsel Göstergeyi (OSD) Göster" Checked="SettingChanged" Unchecked="SettingChanged"/>
                <CheckBox x:Name="ChkTrayIcon" Content="Sistem Tepsisi Simgesini Göster (Tray Icon)" Checked="SettingChanged" Unchecked="SettingChanged"/>
                
                <TextBlock x:Name="TxtStepSize" Text="Ses Değişim Adımı (Yüzdelik):" Margin="0,20,0,5" Foreground="#AAAAAA" FontSize="13"/>
                <Slider x:Name="SldStepSize" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SettingChanged" AutoToolTipPlacement="TopLeft"/>
                
                <TextBlock x:Name="TxtOsdDuration" Text="OSD Gösterim Süresi (ms):" Margin="0,15,0,5" Foreground="#AAAAAA" FontSize="13"/>
                <Slider x:Name="SldOsdDuration" Minimum="500" Maximum="3000" Value="1500" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="SettingChanged" AutoToolTipPlacement="TopLeft"/>

                <TextBlock x:Name="TxtDevices" Text="Cihaz Geçiş Döngüsüne Dahil Edilecekler (Shift + Orta Tuş):" Margin="0,20,0,10" Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap"/>
                <Border BorderBrush="#444" BorderThickness="1" Padding="10" CornerRadius="5">
                    <StackPanel x:Name="PanelDevices"/>
                </Border>
                
                <TextBlock x:Name="TxtNote" Text="Not: Görev çubuğunda; Scroll: Ses, Ctrl+Orta Tuş: Mute, Shift+Orta Tuş: Aygıt Değişimi." 
                           Margin="0,15,0,0" Foreground="#777777" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        
        <Button x:Name="BtnApply" Grid.Row="2" Content="Uygula ve Arka Planda Başlat" Margin="0,20,0,0" Padding="12" 
                Background="#FF6600" Foreground="White" BorderThickness="0" FontSize="15" FontWeight="SemiBold"
                Click="BtnApply_Click" Cursor="Hand"/>
    </Grid>
</Window>
